# ==============================================================================
#  云端 OCR 凭据文件（文档批量转 Markdown 工具）
# ------------------------------------------------------------------------------
#  · 所有 Token 都只放在这一个文件里，config.json 里不必再写凭据。
#  · 格式：一行一个  KEY=VALUE
#        - 以 # 开头的行是注释，随便写；
#        - 值两端可以加引号，也可以不加；
#        - 等号两边不要留空格（行尾的注释请用「空格 + #」，例如 KEY=abc  # 说明）。
#  · 保存编码用 UTF-8 就行（带 BOM 也认；旧版记事本存成 ANSI/GBK 也做了兜底）。
#  · 取值优先级：系统环境变量 > 本文件 > config.json 里的 token 字段。
#    （也就是说本文件填了就以本文件为准；什么都没填才会去读 config.json。）
#  · 改完本文件要**重启**程序才生效（监控模式也需重启，OCR 参数不参与热加载）。
#  · 只填其中一个平台也能跑，缺 Token 的后端会自动不纳入链路，不会报错。
# ==============================================================================


# ------------------------------------------------------------------------------
#  一、MinerU —— https://mineru.net  登录后进「API 管理」页创建 Token
# ------------------------------------------------------------------------------
#  填上后 precision（精度解析）后端即可用：支持 ≤200MB / ≤200 页，
#  超页数会自动按 page_ranges 分段提交再合并；**插图会被一并返回**。
#  留空也能跑（MinerU 轻量接口免 Token），但轻量接口只出文字、不回插图。
DOC2MD_MINERU_TOKEN=

#  只有自建 / 走代理时才需要改服务地址，官方服务保持注释即可。
# DOC2MD_MINERU_BASE_URL=

#  给某个后端单独指定 Token（多账号轮换、想拼额度时用）。
#  变量名规则：DOC2MD_TOKEN_ + 后端名（大写，非字母数字换成下划线）。
#  优先级高于上面的 DOC2MD_MINERU_TOKEN。
# DOC2MD_TOKEN_MINERU_AGENT=


# ------------------------------------------------------------------------------
#  二、PaddleOCR —— 星河社区 aistudio 访问令牌（OCR 主力后端，默认优先级最高）
# ------------------------------------------------------------------------------
#  下面两个是同一个 Token 的两种名字，填任意一个都行：
#    PADDLEOCR_MCP_AISTUDIO_ACCESS_TOKEN —— 官方 MCP 用的名字（已在用，保持默认）
#    DOC2MD_PADDLE_TOKEN                 —— 更好记的别名，优先级更高
PADDLEOCR_MCP_AISTUDIO_ACCESS_TOKEN=
# DOC2MD_PADDLE_TOKEN=

#  给名为 paddle 的后端单独指定 Token（等价写法，一般用不上）。
# DOC2MD_TOKEN_PADDLE=


# ------------------------------------------------------------------------------
#  三、硅基流动 SiliconFlow —— https://siliconflow.cn  控制台「API 密钥」页创建
# ------------------------------------------------------------------------------
#  填上后端即可用：backend 名 `sf-deepseek-ocr`，模型 deepseek-ai/DeepSeek-OCR。
#
#  它的定位：paddle 与 mineru 虽然厂商不同，但**技术形态是同一类**（提交任务→
#  轮询→取结果包，有队列、会背压）。这个后端是一问一答的对话接口，没有队列，
#  故障模式完全不同 —— 真出事时不会跟着一起挂。
#
#  ⚠ 它**不返回插图**，正文里的图片不会有引用。所以它排在 paddle / mineru 之后，
#    只在前两者都不可用时接手。缺插图时日志会提示一次。
#
#  计费：按页/按视觉分块计费（整页全局视图 + 640×640 局部块）。
#        config.json 里该后端 daily_page_limit=2000，用完自动 deferred，不会失控。
DOC2MD_SILICONFLOW_TOKEN=

#  别名（等价，本站不需要填）：SILICONFLOW_API_KEY
# SILICONFLOW_API_KEY=

#  想改接别的 OpenAI 兼容平台时用这个兜底键 —— 它不参与厂商匹配，
#  会发给所有 vlm 类型的后端；同时记得改该后端的 base_url 与 model。
# DOC2MD_VLM_TOKEN=
# DOC2MD_VLM_BASE_URL=

#  按后端名精确指定（比厂商级更具体，优先级最高）。
# DOC2MD_TOKEN_SF_DEEPSEEK_OCR=


# ------------------------------------------------------------------------------
#  四、选型原则（别往链路上加通用对话模型）
# ------------------------------------------------------------------------------
#  本项目要的是**逐字转录**，所以只接 OCR 专用服务。通用视觉对话模型
#  （不论免费与否）不做逐字复现：密排小字（发文号、日期、条款编号）在视觉
#  token 压缩后容易丢或错，还会出现数字幻觉 —— 把〔2024〕15号读成 13号这种
#  错误在 md 里看不出任何异常，归档后极难发现。
#  要往链路上加后端，先确认它是**专用 OCR 模型**且**支持 PDF 或逐页图片输入**。
